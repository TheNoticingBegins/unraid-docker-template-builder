<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" support="https://github.com/TheNoticingBegins">

<CHANGES>
###2026.08.16
- Initial release
- Visual form to build Docker containers
- Generate docker run commands
- Save and load Docker XML templates
- One-click container launch
</CHANGES>

<FILE Name="&plugdir;/DockerBuilder.php">
<INLINE><![CDATA[<?php
/*
 * Docker Builder — PHP backend
 * Handles form processing, command generation, template saving, container launch.
 */

function getDefaultTemplateDir() {
    return "/boot/config/plugins/dockerMan/templates-user";
}

function getTemplateDir() {
    $dir = isset($_POST['template_dir']) ? trim($_POST['template_dir']) : '';
    if ($dir === '') {
        $dir = isset($_GET['template_dir']) ? trim($_GET['template_dir']) : '';
    }
    if ($dir === '') {
        // Check saved config
        $cfg = getConfig();
        $dir = $cfg['template_dir'] ?? '';
    }
    if ($dir === '') {
        $dir = getDefaultTemplateDir();
    }
    return rtrim($dir, '/');
}

function getConfig() {
    $cfgFile = "/boot/config/plugins/docker-builder/config.json";
    if (file_exists($cfgFile)) {
        $data = json_decode(file_get_contents($cfgFile), true);
        if (is_array($data)) return $data;
    }
    return ['template_dir' => getDefaultTemplateDir()];
}

function saveConfig($cfg) {
    $dir = "/boot/config/plugins/docker-builder";
    if (!is_dir($dir)) @mkdir($dir, 0755, true);
    file_put_contents("$dir/config.json", json_encode($cfg, JSON_PRETTY_PRINT));
}

function buildDockerRunCommand($name, $repo, $envVars, $ports, $volumes, $network, $restart, $extraArgs) {
    $cmd = "docker run -d \\\n";
    $cmd .= "  --name=" . escapeshellarg($name) . " \\\n";
    $cmd .= "  --restart=" . escapeshellarg($restart) . " \\\n";
    $cmd .= "  --network=" . escapeshellarg($network) . " \\\n";
    foreach (explode("\n", $envVars) as $line) {
        $line = trim($line);
        if (!$line) continue;
        if (strpos($line, '=') !== false) {
            $cmd .= "  -e " . escapeshellarg($line) . " \\\n";
        }
    }
    foreach (explode("\n", $ports) as $line) {
        $line = trim($line);
        if (!$line || strpos($line, ':') === false) continue;
        $cmd .= "  -p " . escapeshellarg($line) . " \\\n";
    }
    foreach (explode("\n", $volumes) as $line) {
        $line = trim($line);
        if (!$line || strpos($line, ':') === false) continue;
        $cmd .= "  -v " . escapeshellarg($line) . " \\\n";
    }
    if ($extraArgs) {
        $cmd .= "  " . $extraArgs . " \\\n";
    }
    $cmd .= "  " . escapeshellarg($repo);
    return $cmd;
}

function saveDockerTemplate($name, $repo, $repoUrl, $overview, $envVars, $ports, $volumes, $network, $restart, $category, $extraArgs, $templateDir) {
    $safeName = preg_replace('/[^a-zA-Z0-9_-]/', '', $name);
    if (!$safeName) return "Error: Invalid container name";
    if (!is_dir($templateDir)) @mkdir($templateDir, 0755, true);
    $xml = "<?xml version=\"1.0\"?>\n";
    $xml .= "<Container version=\"2\">\n";
    $xml .= "  <Name>" . htmlspecialchars($name) . "</Name>\n";
    $xml .= "  <Repository>" . htmlspecialchars($repo) . "</Repository>\n";
    $xml .= "  <Registry>" . htmlspecialchars($repoUrl) . "</Registry>\n";
    $xml .= "  <Support>" . htmlspecialchars($repoUrl ? $repoUrl . '/issues' : '') . "</Support>\n";
    $xml .= "  <Overview>" . htmlspecialchars($overview) . "</Overview>\n";
    $xml .= "  <Category>" . htmlspecialchars($category) . "</Category>\n";
    if ($network === 'host') {
        $xml .= "  <Networking>\n    <Mode>host</Mode>\n  </Networking>\n";
    }
    foreach (explode("\n", $ports) as $line) {
        $line = trim($line);
        if (!$line || strpos($line, ':') === false) continue;
        list($host, $cont) = explode(':', $line, 2);
        $xml .= "  <Config Name=\"" . htmlspecialchars($cont) . "\" Target=\"" . htmlspecialchars($cont) . "\" Default=\"" . htmlspecialchars($host) . "\" Mode=\"tcp\" Description=\"Port\" Type=\"Port\" />\n";
    }
    foreach (explode("\n", $volumes) as $line) {
        $line = trim($line);
        if (!$line || strpos($line, ':') === false) continue;
        list($host, $cont) = explode(':', $line, 2);
        $xml .= "  <Config Name=\"" . htmlspecialchars(basename($host)) . "\" Target=\"" . htmlspecialchars($cont) . "\" Default=\"" . htmlspecialchars($host) . "\" Mode=\"rw\" Description=\"Volume\" Type=\"Path\" />\n";
    }
    foreach (explode("\n", $envVars) as $line) {
        $line = trim($line);
        if (!$line || strpos($line, '=') === false) continue;
        list($key, $val) = explode('=', $line, 2);
        $xml .= "  <Environment name=\"" . htmlspecialchars($key) . "\" label=\"" . htmlspecialchars($key) . "\" mode=\"s\" description=\"\" default=\"" . htmlspecialchars($val) . "\" required=\"false\" />\n";
    }
    $xml .= "</Container>\n";
    $file = "$templateDir/$safeName.xml";
    if (file_put_contents($file, $xml)) {
        saveConfig(['template_dir' => $templateDir]);
        return "Template saved to $file\n\nIt will appear in Community Applications under 'Installed Apps'.";
    }
    return "Error: Could not write template file.";
}

function launchContainer($name, $repo, $envVars, $ports, $volumes, $network, $restart, $extraArgs) {
    $cmd = buildDockerRunCommand($name, $repo, $envVars, $ports, $volumes, $network, $restart, $extraArgs);
    $output = shell_exec($cmd . " 2>&1");
    if ($output === null) return "Error: Failed to execute docker run command.";
    return "Container launched successfully.\n\nCommand:\n$cmd\n\nOutput:\n" . trim($output);
}

function listTemplates($dir) {
    if (!is_dir($dir)) return [];
    $templates = [];
    foreach (glob("$dir/*.xml") as $f) {
        $xml = simplexml_load_file($f);
        if ($xml && isset($xml->Name)) {
            $templates[] = [
                'name' => (string)$xml->Name,
                'repository' => (string)$xml->Repository,
                'file' => basename($f),
            ];
        }
    }
    return $templates;
}

function loadTemplateFile($file) {
    if (!file_exists($file)) return null;
    $xml = simplexml_load_file($file);
    if (!$xml) return null;
    return [
        'name' => (string)$xml->Name,
        'repository' => (string)$xml->Repository,
        'repo_url' => (string)$xml->Registry,
        'overview' => (string)$xml->Overview,
        'category' => (string)$xml->Category,
    ];
}

if (isset($_GET['ajax'])) {
    header('Content-Type: application/json');
    $templateDir = getTemplateDir();
    $templates = listTemplates($templateDir);
    echo json_encode($templates);
    exit;
}

if (isset($_GET['loadfile'])) {
    header('Content-Type: application/json');
    $templateDir = getTemplateDir();
    $file = basename($_GET['loadfile']);
    $path = "$templateDir/$file";
    $data = loadTemplateFile($path);
    echo json_encode($data ?: []);
    exit;
}
]]></INLINE>
</FILE>

<FILE Name="&plugdir;/DockerBuilder.page">
<INLINE><![CDATA[<?xml version="1.0"?>
<Page name="DockerBuilder" title="Docker Builder" icon="docker.png" markdown="true" menu="Settings">
<PRE>
<?php
require_once '/usr/local/emhttp/plugins/docker-builder/DockerBuilder.php';

$mode = isset($_POST['mode']) ? $_POST['mode'] : '';

$containerName = isset($_POST['container_name']) ? $_POST['container_name'] : '';
$repository    = isset($_POST['repository']) ? $_POST['repository'] : '';
$repoUrl       = isset($_POST['repo_url']) ? $_POST['repo_url'] : '';
$overview      = isset($_POST['overview']) ? $_POST['overview'] : '';
$envVars       = isset($_POST['env_vars']) ? $_POST['env_vars'] : '';
$ports         = isset($_POST['ports']) ? $_POST['ports'] : '';
$volumes       = isset($_POST['volumes']) ? $_POST['volumes'] : '';
$network       = isset($_POST['network']) ? $_POST['network'] : 'bridge';
$restartPolicy = isset($_POST['restart_policy']) ? $_POST['restart_policy'] : 'unless-stopped';
$category      = isset($_POST['category']) ? $_POST['category'] : 'Productivity:';
$extraArgs     = isset($_POST['extra_args']) ? $_POST['extra_args'] : '';

$templateDir = getTemplateDir();

$result = '';
if ($mode === 'build_command') {
    $result = buildDockerRunCommand($containerName, $repository, $envVars, $ports, $volumes, $network, $restartPolicy, $extraArgs);
} elseif ($mode === 'save_template') {
    $result = saveDockerTemplate($containerName, $repository, $repoUrl, $overview, $envVars, $ports, $volumes, $network, $restartPolicy, $category, $extraArgs, $templateDir);
} elseif ($mode === 'launch') {
    $result = launchContainer($containerName, $repository, $envVars, $ports, $volumes, $network, $restartPolicy, $extraArgs);
}
?>
</PRE>
<MARKDOWN>
## Docker Builder

Create Docker containers without clicking through menus. Fill in the details and generate a ready-to-use command or save a template.

---
</MARKDOWN>
<PRE>
<?php
$form = '
<script>
// Load templates into dropdown
async function loadTemplateList() {
    const dir = document.getElementById("template_dir").value;
    try {
        const resp = await fetch("/Settings/DockerBuilder?ajax=1&template_dir=" + encodeURIComponent(dir));
        const templates = await resp.json();
        const sel = document.getElementById("template_select");
        sel.innerHTML = "<option value=\"\">-- Select existing template --</option>";
        for (const t of templates) {
            const opt = document.createElement("option");
            opt.value = t.file;
            opt.textContent = t.name + " (" + t.repository + ")";
            sel.appendChild(opt);
        }
    } catch(e) {}
}

// Load a selected template into the form
async function loadSelectedTemplate(file) {
    if (!file) return;
    const dir = document.getElementById("template_dir").value;
    try {
        const resp = await fetch("/Settings/DockerBuilder?loadfile=" + encodeURIComponent(file) + "&template_dir=" + encodeURIComponent(dir));
        const data = await resp.json();
        if (data.name) {
            document.querySelector("input[name=\"container_name\"").value = data.name;
            document.querySelector("input[name=\"repository\"").value = data.repository || "";
            document.querySelector("input[name=\"repo_url\"").value = data.repo_url || "";
            document.querySelector("input[name=\"overview\"").value = data.overview || "";
            document.querySelector("input[name=\"category\"").value = data.category || "";
        }
    } catch(e) {}
}

// Clear form for new template
function clearForm() {
    document.querySelectorAll("input[type=\"text\"], textarea").forEach(el => el.value = "");
    document.getElementById("template_select").value = "";
}

// Refresh template list when directory changes
document.addEventListener("DOMContentLoaded", function() {
    document.getElementById("template_dir").addEventListener("change", loadTemplateList);
    document.getElementById("template_select").addEventListener("change", function() {
        loadSelectedTemplate(this.value);
    });
    loadTemplateList();
});
</script>

<div class="form-container">
<form method="post" action="/Settings/DockerBuilder">

<h3>Template Directory</h3>
