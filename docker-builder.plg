</PRE>
<PRE>
<?php
$templates = listSavedTemplates();
if ($templates) {
    echo '<h2>Saved Templates</h2>';
    echo '<table class="settings_table"><tr><th>Template</th><th>Container</th><th>Repository</th><th></th></tr>';
    foreach ($templates as $t) {
        echo '<tr><td>' . htmlspecialchars($t['file']) . '</td><td>' . htmlspecialchars($t['name']) . '</td><td>' . htmlspecialchars($t['repository']) . '</td>';
        echo '<td><a href="/Settings/DockerBuilder?load=' . urlencode($t['file']) . '">Load</a></td></tr>';
    }
    echo '</table>';
}
?>
</PRE>
</Page>
]]></INLINE>
</FILE>

</PLUGIN>