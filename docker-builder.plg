<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "docker-builder">
  <!ENTITY author    "Kyle">
  <!ENTITY version   "2026.08.17">
  <!ENTITY launch    "Settings/DockerBuilder">
  <!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
  <!ENTITY pluginURL "">
  <!ENTITY md5       "b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" support="https://github.com/TheNoticingBegins">

<CHANGES>
###2026.08.17
- FIX: Removed all CDATA wrapping - files delivered as base64-echo via shell script
- FIX: SCRIPT before FILE sections to clean old files before fresh install
- FIX: Added remove script (Method=remove) for clean uninstall

###2026.08.16
- FIX: Page now properly shows under Settings as "Docker Builder"
- Complete rebuild matching Unraid XML format
- Full field support: Network, Privileged, CPUset, WebUI, ExtraParams, PostArgs
- GPU button (AMD/NVIDIA device mappings)
- Config entries: Type=Port|Path|Variable|Device
- Requires field for required config warnings
- Template verification matching real Unraid schema
</CHANGES>

<SCRIPT>
mkdir -p /usr/local/emhttp/plugins/docker-builder
rm -f /usr/local/emhttp/plugins/docker-builder/DockerBuilder.php
rm -f /usr/local/emhttp/plugins/docker-builder/DockerBuilder.page
rm -f /usr/local/emhttp/plugins/docker-builder/DockerBuilder.png
exit 0
</SCRIPT>

<FILE Run="/bin/bash">
<INLINE>
mkdir -p /usr/local/emhttp/plugins/docker-builder
echo "" | base64 -d > /usr/local/emhttp/plugins/docker-builder/DockerBuilder.php
chmod 644 /usr/local/emhttp/plugins/docker-builder/DockerBuilder.php
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo "" | base64 -d > /usr/local/emhttp/plugins/docker-builder/DockerBuilder.page
chmod 644 /usr/local/emhttp/plugins/docker-builder/DockerBuilder.page
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo "iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAIAAAD8GO2jAAAAVElEQVR4nGPQsQugKWIYtYAkCxhmniEPjVpAngUQcVpZABdnoMRcXBYgi1PfAjRxKluAKT5qAb3jAHsqonk+GJI5eVgUdlgsoAUatWDUglELhoMFAPNw5VfuHWy4AAAAAElFTkSuQmCC" | base64 -d > /usr/local/emhttp/plugins/docker-builder/DockerBuilder.png
chmod 644 /usr/local/emhttp/plugins/docker-builder/DockerBuilder.png
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf /usr/local/emhttp/plugins/docker-builder
rm -f /boot/config/plugins/docker-builder/builder.cfg
</INLINE>
</FILE>

</PLUGIN>