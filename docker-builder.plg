<tr><td><b>Icon URL</b></td><td><input type="text" name="icon" value="'.$h($d["icon"]).'" style="width:100%" placeholder="https://example.com/icon.png"></td></tr>
</table>

<h3>Config Entries <span style="font-weight:normal;font-size:smaller">Format: Name|Target|Default|Mode|Description|Required|Display|Mask|Value</span></h3>
<p><i>Each line is one entry. Pipe-separated fields. Required=true shows a star in the UI. Display=advanced hides it unless "Show advanced" is ticked.</i></p>
<table class="settings_table">
<tr><td><b>Environment Variables</b> (Type=Variable)</td><td><textarea name="env_config" rows="4" style="width:100%;font-family:monospace" placeholder="BOT_TOKEN|BOT_TOKEN|your-token||Bot token from @BotFather|true">'.$h($d["env_config"]).'</textarea></td></tr>
<tr><td><b>Port Mappings</b> (Type=Port)</td><td><textarea name="port_config" rows="4" style="width:100%;font-family:monospace" placeholder="WebUI|8096|8096|tcp|HTTP web interface|true">'.$h($d["port_config"]).'</textarea></td></tr>
<tr><td><b>Volume Mounts</b> (Type=Path)</td><td><div style="display:flex;gap:6px"><div style="display:flex;gap:6px">
<select id="share_selector" style="flex:1;font-family:monospace" onchange="insertShare()">
<option value="">-- Pick an Unraid share --</option>
</select>
<input type="button" value="Refresh Shares" class="button" onclick="loadShares()" style="flex-shrink:0">
</div>
<script>
async function loadShares() {
    try {
        const r = await fetch("/Settings/DockerBuilder?shares=1");
        const shares = await r.json();
        const sel = document.getElementById("share_selector");
        sel.innerHTML = "<option value=\"\">-- Pick an Unraid share --</option>";
        shares.forEach(s => {
            const o = document.createElement("option");
            o.value = s;
            o.textContent = s;
            sel.appendChild(o);
        });
    } catch(e) {}
}
function insertShare() {
    const sel = document.getElementById("share_selector");
    if (!sel.value) return;
    const txt = document.querySelector("textarea[name=\"vol_config\"]");
    if (!txt) return;
    // Find position after last | to insert the share as default path
    const lines = txt.value.split("\n");
    const last = lines.length - 1;
    const parts = lines[last].split("|");
    // Insert share into the Default field (3rd position, index 2)
    if (parts.length >= 3) {
        parts[2] = sel.value;
        lines[last] = parts.join("|");
    } else if (parts.length === 2) {
        lines[last] = parts.join("|") + "|" + sel.value;
    } else {
        lines[last] = "New Path|/container/path|" + sel.value + "|rw";
    }
    txt.value = lines.join("\n");
}
document.addEventListener("DOMContentLoaded", loadShares);
</script>
<textarea name="vol_config" rows="4" style="width:100%;font-family:monospace" placeholder="Appdata|/config|/mnt/user/appdata/myapp|rw|Config storage|true">'.$h($d["vol_config"]).'</textarea></td></tr>
<tr><td><b>Device Mappings</b> (Type=Device)</td><td><textarea name="dev_config" rows="3" style="width:100%;font-family:monospace" placeholder="Host Device 1|/dev/dri|||GPU acceleration||always">'.$h($d["dev_config"]).'</textarea></td></tr>
</table>

<h3>Advanced</h3>
<table class="settings_table">
<tr><td><b>Extra Parameters</b></td><td>
<textarea name="extra_params" rows="3" style="width:100%;font-family:monospace" placeholder="--device=/dev/dri --device=/dev/kfd">'.$h($d["extra_params"]).'</textarea>
<br>
<input type="button" value="Add AMD GPU" class="button" onclick="addGPU()">
<input type="button" value="Add NVIDIA GPU" class="button" onclick="addNVIDIA()">
</td></tr>
<tr><td><b>Post Args</b></td><td><input type="text" name="post_args" value="'.$h($d["post_args"]).'" style="width:100%;font-family:monospace" placeholder="Arguments after image name"></td></tr>
<tr><td><b>CPUset (CPU Pinning)</b></td><td>
<input type="text" name="cpuset" value="'.$h($d["cpuset"]).'" style="width:100%" placeholder="e.g. 0,1,2,3 or 0-3"><br>
<i>Enter CPU core numbers separated by commas or hyphens. Click cores below to toggle:</i><br>
<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px">';
// Generate clickable CPU core buttons
for ($i = 0; $i <= 15; $i++) {
    $sel = (strpos($d["cpuset"], "$i") !== false) ? ' style="background:#4CAF50;color:white"' : '';
    echo '<span class="button cpu-btn" data-core="'.$i.'" onclick="toggleCPU('.$i.')"'.$sel.'>'.$i.'</span>';
}
echo '
</div>
<script>
function toggleCPU(c) {
    const inp = document.querySelector("[name=\"cpuset\"]");
    let vals = inp.value ? inp.value.split(",").map(x => x.trim()).filter(x => x !== "") : [];
    const idx = vals.indexOf(String(c));
    if (idx > -1) vals.splice(idx, 1); else vals.push(String(c));
    vals.sort((a,b) => parseInt(a)-parseInt(b));
    inp.value = vals.join(",");
    // Update button highlight
    document.querySelectorAll(".cpu-btn").forEach(b => {
        const core = parseInt(b.getAttribute("data-core"));
        b.style.background = inp.value.split(",").indexOf(String(core)) > -1 ? "#4CAF50" : "";
        b.style.color = inp.value.split(",").indexOf(String(core)) > -1 ? "white" : "";
    });
}
</script>
</td></tr>
<tr><td><b>Requires</b></td><td><input type="text" name="requires" value="'.$h($d["requires"]).'" style="width:100%" placeholder="e.g. BOT_TOKEN,AUTHORIZED_USERS"><br><i>Comma-separated env vars that must be set</i></td></tr>
</table>

<br>
<input type="submit" value="Generate docker run Command" class="button">
<input type="submit" value="Save as Docker Template" class="button" formaction="/Settings/DockerBuilder" onclick="this.form.mode.value=\'save_template\'">
<input type="submit" value="Launch Container Now" class="button" style="background:#4CAF50;color:white" formaction="/Settings/DockerBuilder" onclick="this.form.mode.value=\'launch\'">
<input type="submit" value="Verify Templates" class="button" style="background:#FF9800;color:white" formaction="/Settings/DockerBuilder" onclick="this.form.mode.value=\'verify\'">

<script>
async function browseFS() {
    const panel = document.getElementById("browser-panel");
    const path = document.getElementById("browse_path").value || "/mnt/user";
    panel.style.display = "block";
    panel.innerHTML = "Loading...";
    try {
        const r = await fetch("/Settings/DockerBuilder?browse=1&path=" + encodeURIComponent(path));
        const data = await r.json();
        let html = "";
        if (data.parent && data.parent !== data.path) {
            html += "<div style=\"cursor:pointer;padding:4px 6px;color:#4fc3f7;font-weight:bold\" onclick=\"document.getElementById(\'browse_path\').value=\'' + data.parent + '\';browseFS()\">.. (up)</div>";
        }
        for (const item of data.items) {
            const icon = item.is_dir ? "📁" : "📄";
            const click = item.is_dir ? "document.getElementById(\'browse_path\').value=\'' + item.path.replace(/\'/g, "\\'") + '\';browseFS()" : "";
            html += "<div style=\"cursor:pointer;padding:4px 6px\" onclick=\"" + click + "\">" + icon + " " + item.name + "</div>";
        }
        panel.innerHTML = html;
        // If there\'s a target textarea, also offer to insert
        const activeInput = document.activeElement;
        if (activeInput && activeInput.name === "vol_config") {
            panel.innerHTML += "<div style=\"margin-top:8px;padding-top:8px;border-top:1px solid #333\"><i>Click a folder to navigate. Use the path above.</i></div>";
        }
    } catch(e) {
        panel.innerHTML = "Error loading directory";
    }
}
</script>

</form>
</div>';
?>
