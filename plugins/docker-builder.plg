<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "docker-builder">
<!ENTITY author    "Kyle">
<!ENTITY version   "4.0">
<!ENTITY md5       "a9a01ab99f806542790bb4223c684ac2">
<!ENTITY launch    "Settings/DockerBuilder">
<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY pluginURL "">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.7.0" support="https://github.com/TheNoticingBegins">

<CHANGES>
###4.0
- REWRITE: Package shipped as .txz embedded in .plg (no external download)
- FIX: Proper menu entry under Settings that opens a separate page
- Added: source/ directory with extracted plugin files for development

###2026.08.16
- Initial release
</CHANGES>

<FILE Name="/boot/config/plugins/&name;/&name;-&version;-x86_64-1.txz" Run="upgradepkg --install-new">
<INLINE base64="true"></INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
rm -f $(ls /boot/config/plugins/&name;/&name;*.txz 2>/dev/null | grep -v '&version;')
echo ""
echo "----------------------------------------------------"
echo " Docker Builder has been installed."
echo " Version: &version;"
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf /usr/local/emhttp/plugins/docker-builder
rm -f /boot/config/plugins/docker-builder/builder.cfg
</INLINE>
</FILE>

</PLUGIN>
