<?php
require_once '/usr/local/emhttp/plugins/docker-builder/DockerBuilder.php';

$m = isset($_POST['mode']) ? $_POST['mode'] : '';
$fields = ['template_dir','container_name','repository','registry','network','privileged','shell',
    'support','project','readme','overview','category','webui','templateurl','icon',
    'extra_params','post_args','cpuset','requires',
    'env_config','port_config','vol_config','dev_config'];
$d = []; foreach ($fields as $k) $d[$k] = isset($_POST[$k]) ? $_POST[$k] : '';
$td = getTemplateDir();

$r = '';
if ($m === 'build_command') {
    $r = buildDockerRunCommand($d['container_name'],$d['repository'],$d['network'],$d['privileged'],$d['shell'],$d['cpuset'],$d['extra_params'],$d['post_args'],$d['env_config'],$d['port_config'],$d['vol_config'],$d['dev_config']);
} elseif ($m === 'save_template') {
    $r = saveDockerTemplate($d['container_name'],$d['repository'],$d['registry'],$d['network'],$d['privileged'],$d['shell'],$d['support'],$d['project'],$d['readme'],$d['overview'],$d['category'],$d['webui'],$d['templateurl'],$d['icon'],$d['extra_params'],$d['post_args'],$d['cpuset'],$d['requires'],$d['env_config'],$d['port_config'],$d['vol_config'],$d['dev_config'],$td);
} elseif ($m === 'launch') {
    $r = launchContainer($d['container_name'],$d['repository'],$d['network'],$d['privileged'],$d['shell'],$d['cpuset'],$d['extra_params'],$d['post_args'],$d['env_config'],$d['port_config'],$d['vol_config'],$d['dev_config']);
} elseif ($m === 'verify') { $r = implode("\n", verifyAllTemplates($td)); }

$h = 'htmlspecialchars';
$shares = getUnraidShares();
$nets = dockerNetworks();
?>
<h2>Docker Builder</h2>
<p style="color:#888">Create Docker containers. Fill in the form to generate commands or save templates.</p>
<hr>

<script>
async function refreshList() {
    const d = document.getElementById("template_dir").value;
    const r = await fetch("/Settings/DockerBuilder?ajax=1&template_dir="+encodeURIComponent(d));
    const t = await r.json();
    const s = document.getElementById("template_select");
    s.innerHTML = "<option value=\"\">-- Select --</option>";
    t.forEach(x => { const o = document.createElement("option"); o.value=x.file; o.textContent=x.name+" ("+x.repository+")"; s.appendChild(o); });
}
async function loadSelected(file) {
    if (!file) return;
    const d = document.getElementById("template_dir").value;
    const r = await fetch("/Settings/DockerBuilder?loadfile="+encodeURIComponent(file)+"&template_dir="+encodeURIComponent(d));
    const data = await r.json();
    if (!data.name) return;
    document.querySelector("[name=\"container_name\"]").value = data.name || "";
    document.querySelector("[name=\"repository\"]").value = data.repository || "";
    document.querySelector("[name=\"registry\"]").value = data.registry || "";
    document.querySelector("[name=\"network\"]").value = data.network || "bridge";
    document.querySelector("[name=\"privileged\"]").value = data.privileged || "false";
    document.querySelector("[name=\"shell\"]").value = data.shell || "";
    document.querySelector("[name=\"support\"]").value = data.support || "";
    document.querySelector("[name=\"project\"]").value = data.project || "";
    document.querySelector("[name=\"readme\"]").value = data.readme || "";
    document.querySelector("[name=\"overview\"]").value = data.overview || "";
    document.querySelector("[name=\"category\"]").value = data.category || "";
    document.querySelector("[name=\"webui\"]").value = data.webui || "";
    document.querySelector("[name=\"templateurl\"]").value = data.templateurl || "";
    document.querySelector("[name=\"icon\"]").value = data.icon || "";
    document.querySelector("[name=\"extra_params\"]").value = data.extra || "";
    document.querySelector("[name=\"post_args\"]").value = data.post || "";
    document.querySelector("[name=\"cpuset\"]").value = data.cpuset || "";
    document.querySelector("[name=\"requires\"]").value = data.requires || "";
    document.querySelector("[name=\"env_config\"]").value = data.envCfg || "";
    document.querySelector("[name=\"port_config\"]").value = data.portCfg || "";
    document.querySelector("[name=\"vol_config\"]").value = data.volCfg || "";
    document.querySelector("[name=\"dev_config\"]").value = data.devCfg || "";
}
function clearForm() {
    document.querySelectorAll("input, textarea, select").forEach(e => { if (e.type!=="hidden" && e.type!=="submit" && e.type!=="button") e.value=""; });
    document.getElementById("template_select").value="";
}
function addGPU() {
    const e = document.querySelector("[name=\"extra_params\"]");
    const gpu = "--device=/dev/dri --device=/dev/kfd";
    if (e.value.indexOf(gpu)===-1) e.value = (e.value.trim()?e.value.trim()+" ":"") + gpu;
}
function addNVIDIA() {
    const e = document.querySelector("[name=\"extra_params\"]");
    const nv = "--gpus all";
    if (e.value.indexOf(nv)===-1) e.value = (e.value.trim()?e.value.trim()+" ":"") + nv;
}
function toggleCPU(c) {
    const inp = document.querySelector("[name=\"cpuset\"]");
    let vals = inp.value ? inp.value.split(",").map(x => x.trim()).filter(x => x !== "") : [];
    const idx = vals.indexOf(String(c));
    if (idx > -1) vals.splice(idx, 1); else vals.push(String(c));
    vals.sort((a,b) => parseInt(a)-parseInt(b));
    inp.value = vals.join(",");
    document.querySelectorAll(".cpu-btn").forEach(b => {
        const core = parseInt(b.getAttribute("data-core"));
        b.style.background = inp.value.split(",").indexOf(String(core)) > -1 ? "#4CAF50" : "";
        b.style.color = inp.value.split(",").indexOf(String(core)) > -1 ? "white" : "";
    });
}
async function loadShares() {
    try {
        const r = await fetch("/Settings/DockerBuilder?shares=1");
        const shares = await r.json();
        const sel = el || document.getElementById("share_selector");
        sel.innerHTML = "<option value=\"\">-- Pick an Unraid share --</option>";
        shares.forEach(s => { const o = document.createElement("option"); o.value=s; o.textContent=s; sel.appendChild(o); });
    } catch(e) {}
}
function insertShare(el) {
    const sel = el || document.getElementById("share_selector");
    if (!sel.value) return;
    const txt = document.querySelector("textarea[name=\"vol_config\"]");
    if (!txt) return;
    const lines = txt.value.split("\n");
    const last = lines.length - 1;
    const parts = lines[last].split("|");
    if (parts.length >= 3) { parts[2] = sel.value; lines[last] = parts.join("|"); }
    else if (parts.length === 2) { lines[last] = parts.join("|") + "|" + sel.value; }
    else { lines[last] = "New Path|/container/path|" + sel.value + "|rw"; }
    txt.value = lines.join("\n");
}
function addRow(type) {
    const table = document.getElementById(type + "_table");
    const row = table.insertRow(-1);
    const idx = table.rows.length - 1;
    if (type === "port") {
        row.innerHTML = "<td><input type="text" name="p_name_"" + idx + " style="width:100%"></td>" +
            "<td><input type="text" name="p_target_"" + idx + " style="width:100%" placeholder="8096"></td>" +
            "<td><input type="text" name="p_default_"" + idx + " style="width:100%" placeholder="8096"></td>" +
            "<td><select name=p_mode_" + idx + "><option value="tcp">tcp</option><option value="udp">udp</option></select></td>" +
            "<td><input type=button value="X" class=button style="background:#c0392b;color:white" onclick="this.parentElement.parentElement.remove()"></td>";
    } else if (type === "vol") {
        row.innerHTML = "<td><input type="text" name="v_name_"" + idx + " style="width:100%"></td>" +
            "<td><input type="text" name="v_target_"" + idx + " style="width:100%" placeholder="/config"></td>" +
            "<td><input type="text" name="v_default_"" + idx + " style="width:100%" placeholder="/mnt/user/appdata/myapp"></td>" +
            "<td><select name=v_mode_" + idx + "><option value="rw">rw</option><option value="ro">ro</option></select></td>" +
            "<td><input type=button value="X" class=button style="background:#c0392b;color:white" onclick="this.parentElement.parentElement.remove()"></td>";
    } else if (type === "env") {
        row.innerHTML = "<td><input type="text" name="e_name_"" + idx + " style="width:100%"></td>" +
            "<td><input type="text" name="e_target_"" + idx + " style="width:100%" placeholder="BOT_TOKEN"></td>" +
            "<td><input type="text" name="e_default_"" + idx + " style="width:100%"></td>" +
            "<td><select name=e_required_" + idx + "><option value="true">Yes *</option><option value="false">No</option></select></td>" +
            "<td><input type=button value="X" class=button style="background:#c0392b;color:white" onclick="this.parentElement.parentElement.remove()"></td>";
    } else if (type === "dev") {
        row.innerHTML = "<td><input type="text" name="d_name_"" + idx + " style="width:100%"></td>" +
            "<td><input type="text" name="d_target_"" + idx + " style="width:100%" placeholder="/dev/dri"></td>" +
            "<td><input type=button value="X" class=button style="background:#c0392b;color:white" onclick="this.parentElement.parentElement.remove()"></td>";
    }
}
document.addEventListener("DOMContentLoaded", function() {
    document.getElementById("template_dir").addEventListener("change", refreshList);
    document.getElementById("template_select").addEventListener("change", function() { loadSelected(this.value); });
    refreshList(); loadShares();
});
</script>

